---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { CATEGORIES, SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((post) => !post.data.draft);

	return CATEGORIES.map((category) => ({
		params: { category: category.slug },
		props: {
			category,
			posts: posts
				.filter((post) => post.data.category === category.slug)
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { category, posts } = Astro.props;
const pageUrl = new URL(`/categories/${category.slug}/`, Astro.site);

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: '홈', item: new URL('/', Astro.site).href },
		{ '@type': 'ListItem', position: 2, name: '카테고리', item: new URL('/categories/', Astro.site).href },
		{ '@type': 'ListItem', position: 3, name: category.name, item: pageUrl.href },
	],
};
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${category.name} — ${SITE_TITLE}`} description={category.description} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} is:inline />
	</head>
	<body>
		<Header />
		<main>
			<nav class="breadcrumb" aria-label="현재 위치">
				<a href="/">홈</a>
				<span aria-hidden="true">&rsaquo;</span>
				<a href="/categories/">카테고리</a>
				<span aria-hidden="true">&rsaquo;</span>
				<span aria-current="page">{category.name}</span>
			</nav>

			<header class="category-header">
				<h1>{category.name}</h1>
				<p class="intro">{category.intro}</p>
				<p class="post-count">{posts.length}개의 글</p>
			</header>

			{posts.length === 0 ? (
				<p class="empty">아직 이 카테고리에 공개한 글이 없습니다.</p>
			) : (
				<ul>
					{posts.map((post: any) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<div class="post-meta">
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h2>{post.data.title}</h2>
								<p>{post.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			)}

			<nav class="other-categories" aria-label="다른 카테고리">
				<h2>다른 카테고리</h2>
				<ul class="other-list">
					{CATEGORIES.filter((c) => c.slug !== category.slug).map((c) => (
						<li>
							<a href={`/categories/${c.slug}/`}>
								<strong>{c.name}</strong>
								<span>{c.description}</span>
							</a>
						</li>
					))}
				</ul>
			</nav>
		</main>
		<Footer />
	</body>
</html>

<style>
	.breadcrumb {
		font-size: 0.85em;
		color: var(--text-muted);
		margin-bottom: 1.5em;
	}
	.breadcrumb a {
		color: var(--text-muted);
	}
	.breadcrumb a:hover {
		color: var(--accent);
	}
	.breadcrumb span {
		margin: 0 0.4em;
	}
	.breadcrumb [aria-current] {
		margin: 0;
		color: var(--text);
	}
	.category-header {
		margin-bottom: 2.5em;
	}
	.category-header h1 {
		font-size: 2em;
		margin: 0 0 0.4em;
	}
	.intro {
		line-height: 1.9;
		color: var(--text-secondary);
		margin: 0 0 0.8em;
	}
	.post-count {
		color: var(--text-muted);
		font-size: 0.9em;
		margin: 0;
	}
	.empty {
		color: var(--text-muted);
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	li {
		margin-bottom: 0.5em;
	}
	li a {
		display: block;
		padding: 1.2em;
		border-radius: var(--radius);
		text-decoration: none;
		color: var(--text);
		transition: all 0.2s ease;
	}
	li a:hover {
		background: var(--bg-secondary);
	}
	.post-meta {
		font-size: 0.85em;
		color: var(--text-muted);
		margin-bottom: 0.4em;
	}
	li h2 {
		margin: 0 0 0.3em;
		font-size: 1.15em;
	}
	li p {
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.9em;
	}
	.other-categories {
		margin-top: 3.5em;
		padding-top: 2em;
		border-top: 1px solid var(--border);
	}
	.other-categories h2 {
		font-size: 1.1em;
		margin: 0 0 1em;
	}
	.other-list a {
		padding: 1em 1.2em;
		border: 1px solid var(--border);
		margin-bottom: 0.6em;
	}
	.other-list a:hover {
		border-color: var(--accent);
	}
	.other-list strong {
		display: block;
		margin-bottom: 0.2em;
	}
	.other-list span {
		color: var(--text-muted);
		font-size: 0.9em;
	}
</style>
