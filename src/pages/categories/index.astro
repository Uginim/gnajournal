---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { CATEGORIES, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).filter((post) => !post.data.draft);

// 공개하는 글에는 카테고리가 반드시 있어야 한다.
// 스키마에서는 초안을 위해 optional로 두었으므로, 공개 글 누락은 여기서 빌드를 세운다.
const uncategorized = posts.filter((post) => !post.data.category);
if (uncategorized.length > 0) {
	throw new Error(
		`카테고리가 없는 공개 글이 있습니다: ${uncategorized.map((p) => p.id).join(', ')}\n` +
			`src/consts.ts의 CATEGORIES 중 하나를 frontmatter의 category에 지정하세요.`,
	);
}

const counts = new Map(CATEGORIES.map((c) => [c.slug, 0]));
posts.forEach((post) => {
	const slug = post.data.category!;
	counts.set(slug, (counts.get(slug) ?? 0) + 1);
});

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: '홈', item: new URL('/', Astro.site).href },
		{ '@type': 'ListItem', position: 2, name: '카테고리', item: new URL('/categories/', Astro.site).href },
	],
};

const description = `${SITE_TITLE}의 글을 ${CATEGORIES.map((c) => c.name).join(', ')} 세 갈래로 나누어 모았습니다.`;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`카테고리 — ${SITE_TITLE}`} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} is:inline />
	</head>
	<body>
		<Header />
		<main>
			<nav class="breadcrumb" aria-label="현재 위치">
				<a href="/">홈</a>
				<span aria-hidden="true">&rsaquo;</span>
				<span aria-current="page">카테고리</span>
			</nav>

			<header class="page-header">
				<h1>카테고리</h1>
				<p class="lead">
					이 블로그의 글은 세 갈래로 나뉩니다. 각 카테고리를 열면 어떤 관점으로 그 주제를
					다루는지와 지금까지 쓴 글 목록을 볼 수 있습니다.
				</p>
			</header>

			<ul class="category-list">
				{CATEGORIES.map((category) => (
					<li>
						<a href={`/categories/${category.slug}/`}>
							<div class="row">
								<h2>{category.name}</h2>
								<span class="count">{counts.get(category.slug)}개의 글</span>
							</div>
							<p>{category.description}</p>
						</a>
					</li>
				))}
			</ul>

			<p class="tags-note">
				더 좁은 주제로 찾으려면 <a href="/tags/">태그</a>를 이용하세요.
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.breadcrumb {
		font-size: 0.85em;
		color: var(--text-muted);
		margin-bottom: 1.5em;
	}
	.breadcrumb a {
		color: var(--text-muted);
	}
	.breadcrumb a:hover {
		color: var(--accent);
	}
	.breadcrumb span {
		margin: 0 0.4em;
	}
	.breadcrumb [aria-current] {
		margin: 0;
		color: var(--text);
	}
	.page-header {
		margin-bottom: 2.5em;
	}
	.page-header h1 {
		font-size: 2em;
		margin: 0 0 0.4em;
	}
	.lead {
		line-height: 1.9;
		color: var(--text-secondary);
		margin: 0;
	}
	.category-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.category-list li {
		margin-bottom: 0.8em;
	}
	.category-list a {
		display: block;
		padding: 1.4em;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		text-decoration: none;
		color: var(--text);
		transition: all 0.2s ease;
	}
	.category-list a:hover {
		border-color: var(--accent);
		background: var(--bg-secondary);
	}
	.row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1em;
		margin-bottom: 0.4em;
	}
	.category-list h2 {
		margin: 0;
		font-size: 1.25em;
	}
	.count {
		color: var(--text-muted);
		font-size: 0.85em;
		white-space: nowrap;
	}
	.category-list p {
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.92em;
		line-height: 1.7;
	}
	.tags-note {
		margin-top: 2.5em;
		color: var(--text-muted);
		font-size: 0.9em;
	}
</style>
